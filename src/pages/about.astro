---
import PageLayout from "@layouts/PageLayout.astro";
import { buildPageMetadata } from "@lib/metadata/pageMetadata";

const metadata = buildPageMetadata({
  title: "About",
  description: "About Bashir Salami, a hands-on software engineer working across product, frontend, backend, data, cloud, and production systems.",
  path: "/about/"
});
---

<PageLayout
  metadata={metadata}
  eyebrow="About"
  title="I am a hands-on software engineer and technical leader."
  summary="My experience spans product development, frontend systems, backend services, cloud platforms, data engineering, CI/CD, observability, and technical architecture."
>
  <section class="reading-shell mdx-content about-content">
    <p>I care about systems that are understandable, maintainable, measurable, and useful, not complexity for its own sake.</p>
    <p>I tend to work best on problems with unclear boundaries, where product behavior, system design, and production constraints need to be considered together.</p>
    <h2>How I work</h2>
    <p>I prefer explicit boundaries, typed contracts, accessible interfaces, observable systems, and trade-offs that can be explained. The work should become easier to reason about as assumptions are tested and uncertainty is reduced.</p>
  </section>
</PageLayout>
