---
import TechnicalHeroVisual from "@components/astro/TechnicalHeroVisual.astro";
import ProjectCard from "@components/astro/ProjectCard.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { buildProjectPortfolio } from "@lib/content/projects";
import { buildPageMetadata } from "@lib/metadata/pageMetadata";
import { getCollection } from "astro:content";

const { featured: featuredProjects } = buildProjectPortfolio(await getCollection("projects"));

const metadata = buildPageMetadata({
  title: "Bashir Salami — Software Engineer & Technical Leader",
  description: "Product interfaces, backend systems, data, cloud infrastructure, and production operations.",
  path: "/"
});

const capabilityAreas = [
  {
    title: "Interface engineering",
    body: "Complex product interfaces, reusable component systems, stateful workflows, data-heavy views, accessibility, and frontend performance."
  },
  {
    title: "Backend systems",
    body: "Domain models and APIs that make workflow state explicit; asynchronous processing, provider integrations, migrations, idempotency, and failure recovery."
  },
  {
    title: "Data systems",
    body: "Event and health-data pipelines, sessionization, incremental processing, late-arriving records, analytical models, data-quality controls, and the interfaces used to inspect them."
  },
  {
    title: "Platform and operations",
    body: "Cloud infrastructure, Kubernetes, CI/CD, secrets, observability, scaling, deployment safety, and incident investigation."
  }
];
---

<BaseLayout metadata={metadata}>
  <section class="hero content-shell">
    <div class="hero__copy">
      <p class="eyebrow">SOFTWARE ENGINEER · TECHNICAL LEADER</p>
      <h1>I build the product surface and the systems behind it.</h1>
      <p class="lede">I design and ship software across frontend, backend, data, cloud infrastructure, and production operations. I am most useful when a problem crosses those boundaries.</p>
      <div class="hero__actions">
        <a class="button button-primary" href="/work/">View work</a>
        <a class="button button-secondary" href="/about/">How I work</a>
      </div>
    </div>
    <TechnicalHeroVisual />
  </section>

  <section class="section content-shell" aria-labelledby="engineering-system">
    <div class="section-heading">
      <h2 id="engineering-system">Engineering across the system</h2>
      <p>My work includes product interfaces, explicit domain models, health and event-data pipelines, and the infrastructure used to deploy and operate them.</p>
    </div>
    <div class="capability-grid">
      {capabilityAreas.map((area) => (
        <article class="capability-card">
          <h3>{area.title}</h3>
          <p>{area.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section section-muted" aria-labelledby="cross-disciplinary">
    <div class="split-section content-shell">
      <div class="section-heading">
        <h2 id="cross-disciplinary">A production problem rarely stays inside one box.</h2>
        <p>A user-facing failure can begin in the interface, originate in a service, worsen in the database, and remain invisible because the telemetry is incomplete. I trace and fix the whole path.</p>
      </div>
      <div class="system-note" aria-hidden="true">
        <p>Interface</p>
        <p>Service</p>
        <p>Data</p>
        <p>Telemetry</p>
      </div>
    </div>
  </section>

  <section class="section content-shell" aria-labelledby="case-studies">
    <div class="section-heading">
      <h2 id="case-studies">Case studies</h2>
      <p>Three products with different users, business models, and technical constraints.</p>
    </div>
    <div class="selected-work-list">
      {featuredProjects.map((project) => (
        <ProjectCard project={project} variant="home" />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    align-items: center;
    gap: var(--space-8);
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.8fr);
    padding-block: 128px 104px;
  }

  .hero__copy,
  .section-heading {
    display: grid;
    gap: var(--space-5);
  }

  .hero h1 {
    max-width: 860px;
    font-size: var(--text-display-l);
    line-height: 1;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .capability-grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: var(--space-7);
  }

  .capability-card,
  .system-note {
    border: 1px solid var(--color-sand);
    border-radius: var(--radius-md);
    background: var(--color-paper);
    padding: var(--space-5);
  }

  .capability-card {
    display: grid;
    gap: var(--space-3);
  }

  .capability-card h3 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 400;
  }

  .capability-card p,
  .system-note {
    align-content: start;
  }

  .system-note p {
    border-bottom: 1px solid var(--color-sand);
    color: var(--color-charcoal);
    font-family: var(--font-mono);
    font-size: var(--text-mono-s);
    margin: 0;
    padding-block: var(--space-3);
  }

  .system-note p:last-child {
    border-bottom: 0;
  }

  .capability-card p {
    color: var(--color-stone);
  }

  .split-section {
    display: grid;
    gap: var(--space-7);
    grid-template-columns: minmax(0, 0.9fr) minmax(320px, 1fr);
    align-items: start;
  }

  .section-heading p:not(.eyebrow) {
    max-width: 62ch;
    color: var(--color-stone);
  }

  .section-muted .section-heading p,
  .section-muted .eyebrow {
    color: var(--color-charcoal);
  }

  .selected-work-list {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: var(--space-7);
  }

  @media (max-width: 900px) {
    .hero,
    .split-section,
    .capability-grid,
    .selected-work-list {
      grid-template-columns: 1fr;
    }

    .hero {
      padding-block: 88px 64px;
    }
  }
</style>
