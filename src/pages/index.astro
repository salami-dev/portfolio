---
import TechnicalHeroVisual from "@components/astro/TechnicalHeroVisual.astro";
import ProjectCard from "@components/astro/ProjectCard.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { buildProjectPortfolio } from "@lib/content/projects";
import { buildPageMetadata } from "@lib/metadata/pageMetadata";
import { getCollection } from "astro:content";

const { featured: featuredProjects } = buildProjectPortfolio(await getCollection("projects"));

const metadata = buildPageMetadata({
  title: "Bashir Salami — Software Engineer & Technical Leader",
  description: "Product interfaces, backend systems, data, cloud infrastructure, and production operations.",
  path: "/"
});
---

<BaseLayout metadata={metadata}>
  <section class="hero content-shell">
    <div class="hero__copy">
      <p class="eyebrow">SOFTWARE ENGINEER · TECHNICAL LEADER</p>
      <h1>I build the product surface and the systems behind it.</h1>
      <p class="lede">I design and ship software across frontend, backend, data, cloud infrastructure, and production operations. I am most useful when a problem crosses those boundaries.</p>
      <div class="hero__actions">
        <a class="button button-primary" href="/work/">View work</a>
        <a class="button button-secondary" href="/about/">How I work</a>
      </div>
    </div>
    <TechnicalHeroVisual />
  </section>

  <section class="section section-muted" aria-labelledby="ownership">
    <div class="ownership-section content-shell">
      <h2 id="ownership">A problem rarely stays inside one box.</h2>
      <div class="ownership-copy">
        <p>A product issue might show up in the interface, come from a backend rule, depend on the data, or turn out to be a deployment problem. I am comfortable following it through those layers and staying with the work until the outcome is right.</p>
        <p>Working in startups taught me not to treat a job description as the boundary of the problem. When the work has required it, I have also led product, business, and partnership conversations to help move the product forward.</p>
      </div>
    </div>
  </section>

  <section class="section content-shell" aria-labelledby="case-studies">
    <div class="section-heading">
      <h2 id="case-studies">Case studies</h2>
      <p>Three products with different users, business models, and technical constraints.</p>
    </div>
    <div class="selected-work-list">
      {featuredProjects.map((project) => (
        <ProjectCard project={project} variant="home" />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    align-items: center;
    gap: var(--space-8);
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.8fr);
    padding-block: 128px 104px;
  }

  .hero__copy,
  .section-heading {
    display: grid;
    gap: var(--space-5);
  }

  .hero h1 {
    max-width: 860px;
    font-size: var(--text-display-l);
    line-height: 1;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .ownership-section {
    display: grid;
    gap: var(--space-7);
    grid-template-columns: minmax(0, 0.85fr) minmax(320px, 1fr);
    align-items: start;
  }

  .ownership-section h2 {
    max-width: 12ch;
  }

  .ownership-copy {
    display: grid;
    gap: var(--space-5);
    max-width: 62ch;
    color: var(--color-charcoal);
    font-size: var(--text-body-l);
    line-height: 1.6;
  }

  .section-heading p:not(.eyebrow) {
    max-width: 62ch;
    color: var(--color-stone);
  }

  .selected-work-list {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: var(--space-7);
  }

  @media (max-width: 900px) {
    .hero,
    .ownership-section,
    .selected-work-list {
      grid-template-columns: 1fr;
    }

    .hero {
      padding-block: 88px 64px;
    }
  }
</style>
