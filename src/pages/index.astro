---
import TechnicalHeroVisual from "@components/astro/TechnicalHeroVisual.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { buildPageMetadata } from "@lib/metadata/pageMetadata";
import { workPath } from "@lib/routing/urls";
import { getCollection } from "astro:content";

const featuredProjects = (await getCollection("projects"))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.displayOrder - b.data.displayOrder)
  .slice(0, 4);

const metadata = buildPageMetadata({
  title: "Bashir Salami — Software Engineer & Technical Leader",
  description: "Product interfaces, backend systems, data, cloud infrastructure, and production operations.",
  path: "/"
});

const capabilityAreas = [
  {
    title: "Interface engineering",
    body: "Complex product interfaces, reusable component systems, stateful workflows, data-heavy views, accessibility, and frontend performance."
  },
  {
    title: "Backend systems",
    body: "Domain models and APIs that make workflow state explicit; asynchronous processing, provider integrations, migrations, idempotency, and failure recovery."
  },
  {
    title: "Data systems",
    body: "Event and health-data pipelines, sessionization, incremental processing, late-arriving records, analytical models, data-quality controls, and the interfaces used to inspect them."
  },
  {
    title: "Platform and operations",
    body: "Cloud infrastructure, Kubernetes, CI/CD, secrets, observability, scaling, deployment safety, and incident investigation."
  }
];
---

<BaseLayout metadata={metadata}>
  <section class="hero content-shell">
    <div class="hero__copy">
      <p class="eyebrow">SOFTWARE ENGINEER · TECHNICAL LEADER</p>
      <h1>Product interfaces and the systems behind them.</h1>
      <p class="lede">Software engineering across frontend, backend, data, cloud infrastructure, and production operations, with attention to how those layers behave as one product system.</p>
      <div class="hero__actions">
        <a class="button button-primary" href="/work/">View selected work</a>
        <a class="button button-secondary" href="/about/">Working approach</a>
      </div>
    </div>
    <TechnicalHeroVisual />
  </section>

  <section class="section content-shell" aria-labelledby="engineering-system">
    <div class="section-heading">
      <p class="eyebrow">Across the system</p>
      <h2 id="engineering-system">Product behavior and system behavior are usually connected.</h2>
      <p>User workflows, backend state, data movement, deployment, and observability all shape the same experience. Good engineering makes those relationships visible enough to build, operate, and change safely.</p>
    </div>
    <div class="capability-grid">
      {capabilityAreas.map((area) => (
        <article class="capability-card">
          <h3>{area.title}</h3>
          <p>{area.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section section-muted" aria-labelledby="cross-disciplinary">
    <div class="split-section content-shell">
      <div class="section-heading">
        <p class="eyebrow">Cross-disciplinary by necessity</p>
        <h2 id="cross-disciplinary">A production problem rarely stays inside one box.</h2>
        <p>A user-facing failure can begin in the interface, originate in a service, worsen in the database, and remain invisible because the telemetry is incomplete. The fix usually depends on understanding the whole path.</p>
      </div>
      <div class="system-note" aria-hidden="true">
        <p>Interface</p>
        <p>Service</p>
        <p>Data</p>
        <p>Telemetry</p>
      </div>
    </div>
  </section>

  <section class="section content-shell" aria-labelledby="selected-work">
    <div class="section-heading">
      <p class="eyebrow">Selected work</p>
      <h2 id="selected-work">Selected systems across product, platform, and operations.</h2>
      <p>These projects cover platform modernization, browser product delivery, health-data integration, financial workflows, infrastructure, and production operations.</p>
    </div>
    <div class="selected-work-list">
      {featuredProjects.map((project) => (
        <article class="selected-work-card">
          <h3><a href={workPath(project.data.slug)}>{project.data.title}</a></h3>
          <p>{project.data.summary}</p>
          <p class="owned"><strong>Responsibility:</strong> {project.data.role}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    align-items: center;
    gap: var(--space-8);
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.8fr);
    padding-block: 128px 104px;
  }

  .hero__copy,
  .section-heading {
    display: grid;
    gap: var(--space-5);
  }

  .hero h1 {
    max-width: 860px;
    font-size: var(--text-display-l);
    line-height: 1;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .capability-grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: var(--space-7);
  }

  .capability-card,
  .system-note {
    border: 1px solid var(--color-sand);
    border-radius: var(--radius-md);
    background: var(--color-paper);
    padding: var(--space-5);
  }

  .capability-card {
    display: grid;
    gap: var(--space-3);
  }

  .capability-card h3 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 400;
  }

  .capability-card p,
  .system-note {
    align-content: start;
  }

  .system-note p {
    border-bottom: 1px solid var(--color-sand);
    color: var(--color-charcoal);
    font-family: var(--font-mono);
    font-size: var(--text-mono-s);
    margin: 0;
    padding-block: var(--space-3);
  }

  .system-note p:last-child {
    border-bottom: 0;
  }

  .capability-card p {
    color: var(--color-stone);
  }

  .split-section {
    display: grid;
    gap: var(--space-7);
    grid-template-columns: minmax(0, 0.9fr) minmax(320px, 1fr);
    align-items: start;
  }

  .section-heading p:not(.eyebrow) {
    max-width: 62ch;
    color: var(--color-stone);
  }

  .section-muted .section-heading p,
  .section-muted .eyebrow {
    color: var(--color-charcoal);
  }

  .selected-work-list {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: var(--space-7);
  }

  .selected-work-card {
    display: grid;
    gap: var(--space-3);
    border: 1px solid var(--color-sand);
    border-radius: var(--radius-md);
    background: var(--color-paper);
    padding: var(--space-5);
  }

  .selected-work-card h3 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 400;
  }

  .selected-work-card h3 a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .selected-work-card h3 a:hover {
    color: var(--color-forest);
  }

  .selected-work-card p {
    color: var(--color-stone);
  }

  .selected-work-card .owned {
    font-size: var(--text-body-s);
  }

  .selected-work-card strong {
    color: var(--color-charcoal);
  }

  @media (max-width: 900px) {
    .hero,
    .split-section,
    .capability-grid,
    .selected-work-list {
      grid-template-columns: 1fr;
    }

    .hero {
      padding-block: 88px 64px;
    }
  }
</style>
