---
import ObfuscatedEmailLink from "@components/astro/ObfuscatedEmailLink.astro";
import PageLayout from "@layouts/PageLayout.astro";
import { buildPageMetadata } from "@lib/metadata/pageMetadata";

const metadata = buildPageMetadata({
  title: "Contact",
  description: "Discuss senior engineering, platform, backend, full-stack, data, performance, or technical-leadership work.",
  path: "/contact/"
});
---

<PageLayout
  metadata={metadata}
  eyebrow="Contact"
  title="Let's discuss a product or engineering problem that crosses technical boundaries."
  summary="I am interested in senior engineering, platform, backend, full-stack, performance, and technical-leadership work involving complex products, system modernization, data-intensive applications, cloud platforms, or production reliability."
>
  <section class="reading-shell contact-list" id="email">
    <p>Email is the best way to reach me. You can also find my work and professional background on GitHub and LinkedIn.</p>
    <ObfuscatedEmailLink />
    <a href="https://github.com/salami-dev">GitHub</a>
    <a href="https://www.linkedin.com/in/bashir-salami">LinkedIn</a>
    <noscript>
      <p>Email is protected from basic scraping and requires JavaScript to reveal. GitHub and LinkedIn are available above.</p>
    </noscript>
  </section>
</PageLayout>

<style>
  .contact-list {
    display: grid;
    gap: var(--space-4);
    padding-block-end: var(--space-10);
  }

  .contact-list > p {
    max-width: 62ch;
    color: var(--color-stone);
  }

  .contact-list > :global(a),
  .contact-list > :global(.email-reveal) {
    min-height: 52px;
    border: 1px solid var(--color-sand);
    border-radius: var(--radius-sm);
    background: var(--color-paper);
    color: var(--color-charcoal);
    font-weight: 700;
    padding: var(--space-4);
    text-decoration: none;
  }

  .contact-list > :global(.email-reveal) {
    align-items: center;
  }
</style>
