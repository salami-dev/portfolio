---
import PageLayout from "@layouts/PageLayout.astro";
import { buildPageMetadata } from "@lib/metadata/pageMetadata";
import { workPath } from "@lib/routing/urls";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort((a, b) => a.data.displayOrder - b.data.displayOrder);
const flagshipProjects = projects.filter((project) => project.data.featured);
const supportingProjects = projects.filter((project) => !project.data.featured);

const metadata = buildPageMetadata({
  title: "Selected Engineering Work — Bashir Salami",
  description: "Case studies across frontend engineering, backend systems, data platforms, cloud infrastructure, payments, and production operations.",
  path: "/work/"
});
---

<PageLayout
  metadata={metadata}
  eyebrow="Work"
  title="Systems where product behavior, architecture, data, and operations had to work together."
  summary="This is not a complete employment history. It is a selection of projects that show different parts of how I work: building user-facing products, modelling difficult domains, integrating external systems, designing data flows, and operating software in production."
>
  <section class="content-shell work-section" aria-labelledby="work-overview">
    <div class="work-panel">
      <p class="eyebrow">Selected work</p>
      <h2 id="work-overview">Three projects carry the main evidence.</h2>
      <p>Audicin V2 shows platform and health-data integration work. Audicin Web shows the product interface and delivery path. Bridger shows backend domain modelling around identity, wallet state, payments, and repayments.</p>
    </div>
    <div class="section-heading">
      <p class="eyebrow">Flagship work</p>
      <h2>Primary case studies</h2>
    </div>
    <div class="work-list work-list--flagship">
      {flagshipProjects.map((project) => (
        <article class="work-entry">
          <div class="work-entry__visual" role="img" aria-label={project.data.cover?.alt ?? `Technical visual frame for ${project.data.title}`}>
            {project.data.mainImage ? (
              <img src={project.data.mainImage.src} alt="" loading="lazy" decoding="async" />
            ) : (
              <span>{project.data.cover?.label ?? "Technical visual frame"}</span>
            )}
          </div>
          <div class="work-entry__body">
            <div class="metadata-row">
              <span>{project.data.year}</span>
            </div>
            <h2><a href={workPath(project.data.slug)}>{project.data.title}</a></h2>
            <p class="summary">{project.data.summary}</p>
            <p>{project.data.thesis}</p>
            <dl>
              <div>
                <dt>My responsibility</dt>
                <dd>{project.data.role}</dd>
              </div>
              <div>
                <dt>The hard part</dt>
                <dd>{project.data.complexity}</dd>
              </div>
            </dl>
            <div class="tag-list" aria-label={`Disciplines for ${project.data.title}`}>
              {project.data.disciplines.map((discipline) => <span class="tag">{discipline}</span>)}
            </div>
            <a class="story-link" href={workPath(project.data.slug)}>View case study</a>
          </div>
        </article>
      ))}
    </div>

    <div class="section-heading section-heading--supporting">
      <p class="eyebrow">Additional systems and platform work</p>
      <h2>Supporting work</h2>
      <p>Shorter examples of backend, payment, partner, mobile-support, architecture, and delivery work. These stay compact until there is enough public evidence for a full case study.</p>
    </div>
    <div class="supporting-list">
      {supportingProjects.map((project) => (
        <article class="supporting-entry">
          <div class="metadata-row">
            <span>{project.data.year}</span>
          </div>
          <h3><a href={workPath(project.data.slug)}>{project.data.title}</a></h3>
          <p>{project.data.summary}</p>
          <dl>
            <div>
              <dt>My responsibility</dt>
              <dd>{project.data.role}</dd>
            </div>
          </dl>
          <a class="story-link" href={workPath(project.data.slug)}>View project detail</a>
        </article>
      ))}
    </div>
  </section>
</PageLayout>

<style>
  .work-section {
    display: grid;
    gap: var(--space-6);
    padding-block-end: var(--space-10);
  }

  .work-panel {
    border: 1px solid var(--color-sand);
    border-radius: var(--radius-md);
    background: var(--color-paper);
    padding: var(--space-5);
  }

  .work-panel {
    display: grid;
    gap: var(--space-4);
  }

  .work-list {
    display: grid;
    gap: var(--space-5);
  }

  .section-heading {
    display: grid;
    gap: var(--space-3);
  }

  .section-heading--supporting {
    margin-top: var(--space-7);
  }

  .section-heading p:not(.eyebrow) {
    max-width: 68ch;
    color: var(--color-stone);
  }

  .work-entry {
    display: grid;
    grid-template-columns: minmax(220px, 0.35fr) minmax(0, 1fr);
    overflow: hidden;
    border: 1px solid var(--color-sand);
    border-radius: var(--radius-md);
    background: var(--color-paper);
  }

  .work-entry__visual {
    display: grid;
    min-block-size: 100%;
    place-items: center;
    border-inline-end: 1px solid var(--color-sand);
    background:
      linear-gradient(135deg, rgb(15 118 110 / 0.1), transparent 45%),
      linear-gradient(160deg, var(--color-mist), var(--color-paper));
    padding: var(--space-5);
  }

  .work-entry__visual span {
    max-inline-size: 22ch;
    color: var(--color-stone);
    font-family: var(--font-mono);
    font-size: var(--text-mono-s);
    text-align: center;
  }

  .work-entry__visual img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .work-entry__body {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
  }

  .work-entry h2 {
    font-size: clamp(1.45rem, 3vw, 2rem);
  }

  .work-entry h2 a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .work-entry h2 a:hover {
    color: var(--color-forest);
  }

  .summary {
    color: var(--color-charcoal);
    font-size: var(--text-body-l);
  }

  dl {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }

  dl div {
    display: grid;
    gap: var(--space-1);
  }

  dt {
    color: var(--color-copper);
    font-family: var(--font-mono);
    font-size: var(--text-mono-s);
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    color: var(--color-stone);
  }

  .story-link {
    justify-self: start;
    color: var(--color-forest);
    font-weight: 700;
  }

  .work-panel p:not(.eyebrow),
  .work-entry p:not(.summary) {
    color: var(--color-stone);
  }

  .supporting-list {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .supporting-entry {
    display: grid;
    gap: var(--space-3);
    border: 1px solid var(--color-sand);
    border-radius: var(--radius-md);
    background: var(--color-paper);
    padding: var(--space-5);
  }

  .supporting-entry h3 {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    font-weight: 400;
  }

  .supporting-entry h3 a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .supporting-entry h3 a:hover {
    color: var(--color-forest);
  }

  .supporting-entry p,
  .supporting-entry dd {
    color: var(--color-stone);
  }

  @media (max-width: 820px) {
    .work-entry,
    .supporting-list {
      grid-template-columns: 1fr;
    }

    .work-entry__visual {
      min-block-size: 180px;
      border-inline-end: 0;
      border-block-end: 1px solid var(--color-sand);
    }
  }
</style>
