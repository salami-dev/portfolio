---
import PageLayout from "@layouts/PageLayout.astro";
import { formatStatus } from "@lib/content/status";
import { buildPageMetadata } from "@lib/metadata/pageMetadata";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort((a, b) => a.data.displayOrder - b.data.displayOrder);

const metadata = buildPageMetadata({
  title: "Work",
  description: "Selected work by Bashir Salami across interface engineering, backend systems, data, cloud, reliability, performance, and architecture.",
  path: "/work/"
});
---

<PageLayout
  metadata={metadata}
  eyebrow="Work"
  title="Selected work across product, backend, data, and infrastructure."
  summary="A concise view of systems I have built or contributed to, using only details I can state publicly."
>
  <section class="content-shell work-section" aria-labelledby="work-overview">
    <div class="work-panel">
      <p class="eyebrow">Work overview</p>
      <h2 id="work-overview">The common thread is owning the connections between layers.</h2>
      <p>These projects span product surfaces, backend systems, financial and health-related workflows, cloud infrastructure, delivery pipelines, and production operations. Fuller case studies can be added where the details are safe to publish.</p>
    </div>
    <div class="work-list">
      {projects.map((project) => (
        <article class="work-entry">
          <div class="work-entry__visual" role="img" aria-label={project.data.cover?.alt ?? `Technical visual frame for ${project.data.title}`}>
            <span>{project.data.cover?.label ?? "Technical visual frame"}</span>
          </div>
          <div class="work-entry__body">
            <div class="metadata-row">
              <span>{formatStatus(project.data.status)}</span>
              <span>{project.data.year}</span>
            </div>
            <h2>{project.data.title}</h2>
            <p class="summary">{project.data.summary}</p>
            <p>{project.data.thesis}</p>
            <dl>
              <div>
                <dt>Owned</dt>
                <dd>{project.data.role}</dd>
              </div>
              <div>
                <dt>Technical complexity</dt>
                <dd>{project.data.complexity}</dd>
              </div>
            </dl>
            <div class="tag-list" aria-label={`Disciplines for ${project.data.title}`}>
              {project.data.disciplines.map((discipline) => <span class="tag">{discipline}</span>)}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</PageLayout>

<style>
  .work-section {
    display: grid;
    gap: var(--space-6);
    padding-block-end: var(--space-10);
  }

  .work-panel {
    border: 1px solid var(--color-sand);
    border-radius: var(--radius-md);
    background: var(--color-paper);
    padding: var(--space-5);
  }

  .work-panel {
    display: grid;
    gap: var(--space-4);
  }

  .work-list {
    display: grid;
    gap: var(--space-5);
  }

  .work-entry {
    display: grid;
    grid-template-columns: minmax(220px, 0.35fr) minmax(0, 1fr);
    overflow: hidden;
    border: 1px solid var(--color-sand);
    border-radius: var(--radius-md);
    background: var(--color-paper);
  }

  .work-entry__visual {
    display: grid;
    min-block-size: 100%;
    place-items: center;
    border-inline-end: 1px solid var(--color-sand);
    background:
      linear-gradient(135deg, rgb(15 118 110 / 0.1), transparent 45%),
      linear-gradient(160deg, var(--color-mist), var(--color-paper));
    padding: var(--space-5);
  }

  .work-entry__visual span {
    max-inline-size: 22ch;
    color: var(--color-stone);
    font-family: var(--font-mono);
    font-size: var(--text-mono-s);
    text-align: center;
  }

  .work-entry__body {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
  }

  .work-entry h2 {
    font-size: clamp(1.45rem, 3vw, 2rem);
  }

  .summary {
    color: var(--color-charcoal);
    font-size: var(--text-body-l);
  }

  dl {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }

  dl div {
    display: grid;
    gap: var(--space-1);
  }

  dt {
    color: var(--color-copper);
    font-family: var(--font-mono);
    font-size: var(--text-mono-s);
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    color: var(--color-stone);
  }

  .work-panel p:not(.eyebrow),
  .work-entry p:not(.summary) {
    color: var(--color-stone);
  }

  @media (max-width: 820px) {
    .work-entry {
      grid-template-columns: 1fr;
    }

    .work-entry__visual {
      min-block-size: 180px;
      border-inline-end: 0;
      border-block-end: 1px solid var(--color-sand);
    }
  }
</style>
