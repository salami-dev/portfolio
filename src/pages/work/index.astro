---
import PageLayout from "@layouts/PageLayout.astro";
import ProjectCard from "@components/astro/ProjectCard.astro";
import { buildProjectPortfolio } from "@lib/content/projects";
import { buildPageMetadata } from "@lib/metadata/pageMetadata";
import { getCollection } from "astro:content";

const { featured: flagshipProjects, supporting: supportingProjects } = buildProjectPortfolio(await getCollection("projects"));

const metadata = buildPageMetadata({
  title: "Engineering Work — Bashir Salami",
  description: "Case studies across frontend engineering, backend systems, data platforms, cloud infrastructure, payments, and production operations.",
  path: "/work/"
});
---

<PageLayout
  metadata={metadata}
  eyebrow="Work"
  title="Products for listening, wellbeing, inventory financing, and tuition payments."
  summary="Built for consumers, external partners, and businesses, with software, data, delivery, and production systems shaped around each product."
>
  <section class="content-shell work-section" aria-label="Projects">
    <div class="work-list work-list--flagship">
      {flagshipProjects.map((project) => (
        <ProjectCard project={project} variant="featured" />
      ))}
    </div>

    <div class="supporting-list">
      {supportingProjects.map((project) => (
        <ProjectCard project={project} variant="supporting" />
      ))}
    </div>
  </section>
</PageLayout>

<style>
  .work-section {
    display: grid;
    gap: var(--space-6);
    padding-block-end: var(--space-10);
  }

  .work-list {
    display: grid;
    gap: var(--space-5);
  }

  .supporting-list {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: var(--space-7);
  }

  @media (max-width: 820px) {
    .supporting-list {
      grid-template-columns: 1fr;
    }
  }
</style>
