---
import { workPath } from "@lib/routing/urls";
import type { CollectionEntry } from "astro:content";

type CardVariant = "home" | "featured" | "supporting";

type Props = {
  project: CollectionEntry<"projects">;
  variant: CardVariant;
};

const { project, variant } = Astro.props;
const isFeatured = variant === "featured";
const headingClass = variant === "home" ? "project-card__title project-card__title--home" : "project-card__title";
const linkLabel = variant === "supporting" ? "Read project" : "Read case study";
---

<article class:list={["project-card", `project-card--${variant}`]} data-project-card data-card-variant={variant}>
  {isFeatured && (
    <div class="project-card__visual" role="img" aria-label={project.data.cover?.alt ?? `Technical visual frame for ${project.data.title}`}>
      {project.data.mainImage ? (
        <img src={project.data.mainImage.src} alt="" loading="lazy" decoding="async" />
      ) : (
        <span>{project.data.cover?.label ?? "Technical visual frame"}</span>
      )}
    </div>
  )}

  <div class="project-card__body">
    {variant === "home" ? (
      <h3 class={headingClass}><a href={workPath(project.data.slug)}>{project.data.title}</a></h3>
    ) : (
      <h2 class={headingClass}><a href={workPath(project.data.slug)}>{project.data.title}</a></h2>
    )}

    <p class="project-card__context">{project.data.context}</p>
    <p class="project-card__contribution">{project.data.role}</p>
    <p class="project-card__impact"><strong>Impact:</strong> {project.data.impact}</p>

    <div class="tag-list" aria-label={`Disciplines for ${project.data.title}`}>
      {project.data.disciplines.map((discipline) => <span class="tag">{discipline}</span>)}
    </div>

    <p class="project-card__challenge"><strong>Key challenge:</strong> {project.data.complexity}</p>
    <a class="project-card__link" href={workPath(project.data.slug)}>{linkLabel} →</a>
  </div>
</article>

<style>
  .project-card {
    overflow: hidden;
    border: 1px solid var(--color-sand);
    border-radius: var(--radius-md);
    background: var(--color-paper);
  }

  .project-card--featured {
    display: grid;
    grid-template-columns: minmax(220px, 0.35fr) minmax(0, 1fr);
  }

  .project-card--home,
  .project-card--supporting {
    height: 100%;
  }

  .project-card__visual {
    display: grid;
    min-block-size: 100%;
    place-items: center;
    border-inline-end: 1px solid var(--color-sand);
    background:
      linear-gradient(135deg, rgb(15 118 110 / 0.1), transparent 45%),
      linear-gradient(160deg, var(--color-mist), var(--color-paper));
    padding: var(--space-5);
  }

  .project-card__visual span {
    max-inline-size: 22ch;
    color: var(--color-stone);
    font-family: var(--font-mono);
    font-size: var(--text-mono-s);
    text-align: center;
  }

  .project-card__visual img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .project-card__body {
    display: grid;
    align-content: start;
    gap: var(--space-4);
    padding: var(--space-5);
  }

  .project-card__title {
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 3vw, 2rem);
    font-weight: 400;
  }

  .project-card__title--home {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .project-card__title a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .project-card__title a:hover {
    color: var(--color-forest);
  }

  .project-card__context {
    color: var(--color-charcoal);
    font-size: var(--text-body-l);
  }

  .project-card__contribution,
  .project-card__challenge {
    color: var(--color-stone);
  }

  .project-card__impact {
    border-inline-start: 3px solid var(--color-copper);
    color: var(--color-charcoal);
    padding-inline-start: var(--space-3);
  }

  .project-card__impact strong,
  .project-card__challenge strong {
    color: var(--color-charcoal);
  }

  .project-card__challenge {
    font-size: var(--text-body-s);
  }

  .project-card__link {
    justify-self: start;
    color: var(--color-forest);
    font-weight: 700;
  }

  @media (max-width: 820px) {
    .project-card--featured {
      grid-template-columns: 1fr;
    }

    .project-card__visual {
      min-block-size: 180px;
      border-inline-end: 0;
      border-block-end: 1px solid var(--color-sand);
    }
  }
</style>
