---
import ObfuscatedEmailLink from "@components/astro/ObfuscatedEmailLink.astro";

const isContactPage = Astro.url.pathname === "/contact/";
---

<footer class="site-footer">
  <div class="site-footer__inner content-shell">
    <div>
      <h2>Have a product or system problem that crosses technical boundaries?</h2>
    </div>
    <address class="footer-links">
      <ObfuscatedEmailLink compact />
      <a href="https://github.com/salami-dev">GitHub</a>
      <a href="https://www.linkedin.com/in/bashir-salami">LinkedIn</a>
    </address>
    {!isContactPage && <a class="button button-primary" href="/contact/">Get in touch</a>}
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-charcoal);
    color: white;
    padding-block: var(--space-8);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .site-footer h2 {
    max-width: 760px;
    color: white;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-4);
    font-style: normal;
  }

  .footer-links a,
  .footer-links :global(.email-reveal__button) {
    color: white;
  }

  @media (max-width: 760px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
