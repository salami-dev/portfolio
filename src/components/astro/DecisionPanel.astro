---
type Decision = {
  title: string;
  explanation: string;
};

type Props = {
  decisions: Decision[];
};

const { decisions } = Astro.props;
---

<section class="decision-panel" aria-labelledby="key-decisions-heading">
  <h2 id="key-decisions-heading">Key decisions</h2>
  <div class="decision-panel__list">
    {decisions.map((decision) => (
      <article>
        <h3>{decision.title}</h3>
        <p>{decision.explanation}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .decision-panel {
    display: grid;
    gap: var(--space-5);
    border: 1px solid var(--color-sand);
    border-radius: var(--radius-md);
    background: var(--color-mist);
    padding: var(--space-5);
  }

  .decision-panel > h2 {
    margin: 0;
  }

  .decision-panel__list {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  article {
    border-block-start: 1px solid var(--color-sand);
    padding-block-start: var(--space-4);
  }

  h3 {
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: var(--text-body-l);
    font-weight: 700;
    margin: 0;
  }

  p {
    color: var(--color-charcoal);
    margin: var(--space-2) 0 0;
  }

  @media (max-width: 760px) {
    .decision-panel__list {
      grid-template-columns: 1fr;
    }
  }
</style>
