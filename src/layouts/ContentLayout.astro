---
import BaseLayout from "@layouts/BaseLayout.astro";
import type { PageMetadata } from "@lib/metadata/pageMetadata";

type Props = {
  metadata: PageMetadata;
  eyebrow: string;
  title: string;
  summary: string;
};

const { metadata, eyebrow, title, summary } = Astro.props;
---

<BaseLayout metadata={metadata}>
  <article class="content-page">
    <header class="content-header reading-shell">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="lede">{summary}</p>
      <slot name="meta" />
    </header>
    <div class="reading-shell mdx-content">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .content-page {
    padding-block: var(--space-8) var(--space-10);
  }

  .content-header {
    display: grid;
    gap: var(--space-5);
    margin-bottom: var(--space-8);
  }
</style>
