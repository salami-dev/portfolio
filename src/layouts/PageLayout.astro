---
import BaseLayout from "@layouts/BaseLayout.astro";
import type { PageMetadata } from "@lib/metadata/pageMetadata";

type Props = {
  metadata: PageMetadata;
  eyebrow: string;
  title: string;
  summary: string;
};

const { metadata, eyebrow, title, summary } = Astro.props;
---

<BaseLayout metadata={metadata}>
  <header class="page-header content-shell">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="lede">{summary}</p>
  </header>
  <slot />
</BaseLayout>

<style>
  .page-header {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-8) var(--space-7);
  }

  .page-header h1 {
    max-width: 880px;
  }
</style>
