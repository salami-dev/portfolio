{
  "name": "portfolio",
  "version": "1.0.0",
  "description": "A static editorial engineering portfolio built with Astro, MDX, and typed content collections.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "npm run build && wrangler dev",
    "astro": "astro",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:dev": "PLAYWRIGHT_SERVER_MODE=dev playwright test",
    "test:e2e:all": "npm run test:e2e:dev && npm run test:e2e",
    "test:e2e:ui": "playwright test --ui",
    "travel:photo": "node scripts/sanitize-travel-image.mjs",
    "check": "npm run typecheck && npm run test && npm run build && npm run test:e2e:all",
    "generate-types": "wrangler types",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.3",
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/react": "^6.0.1",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.1",
    "d3": "^7.9.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "reactflow": "^11.11.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "axe-core": "^4.12.1",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  },
  "private": true
}
